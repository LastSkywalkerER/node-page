# node-stats stack configuration (Compose variable substitution).
# The installer writes this file. JWT_SECRET / REFRESH_SECRET are NOT here —
# the setup wizard generates them into .env.agent on first run.

# Image to run. Pin a version tag (e.g. :v1.2.3) for reproducible deploys.
NODE_STATS_IMAGE=ghcr.io/lastskywalkerer/node-page:latest

# Published HTTP port on the host (browse http://localhost:<port>).
NODE_STATS_PORT=9090

# Absolute host path of this stack directory. The controller identity-mounts it
# at the same path so its `docker compose` bind paths resolve to real host paths.
NODE_STATS_STACK_HOST_DIR=__STACK_DIR__

# Compose project name shared by the installer and the controller so they manage
# the same containers.
COMPOSE_PROJECT_NAME=node-stats

GIN_MODE=release
